+    def _trim_image_history(
+        self, messages: list[dict[str, Any]]
+    ) -> list[dict[str, Any]]:
+        """Drop image blocks from all but the last ``BEDROCK_IMAGE_WINDOW`` turns.
+
+        Only applied on the Bedrock route, where the cumulative multi-image
+        payload otherwise trips a 503 around turn ~100. Counts images from the
+        end; once the budget is spent, each older image block is replaced with a
+        short text placeholder so the message structure (and any tool_result
+        pairing) stays valid. Deep-copies only the messages it edits; the input
+        list and ``self._messages`` are untouched.
+        """
+        if not self.bedrock:
+            return messages
+        budget = self.BEDROCK_IMAGE_WINDOW
+        out = list(messages)
+        for i in range(len(out) - 1, -1, -1):
+            content = get_any(out[i], "content")
+            if not isinstance(content, list):
+                continue
+            has_image = any(
+                isinstance(b, dict) and b.get("type") == "image" for b in content
+            )
+            if not has_image:
+                continue
+            if budget > 0:
+                budget -= 1
+                continue
+            new_msg = copy.deepcopy(out[i])
+            new_msg["content"] = [
+                {"type": "text", "text": "[screenshot omitted to bound payload]"}
+                if isinstance(b, dict) and b.get("type") == "image"
+                else b
+                for b in new_msg["content"]
+            ]
+            out[i] = new_msg
+        return out
+
