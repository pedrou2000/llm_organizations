diff --git a/tasks/excel-clone/task.toml b/tasks/excel-clone/task.toml
index e3aaff5..260158f 100644
--- a/tasks/excel-clone/task.toml
+++ b/tasks/excel-clone/task.toml
@@ -163,12 +163,21 @@ required = true
 [[verifiers]]
 name = "ux"
 type = "cua"
-timeout_sec = 1800.0
+# LOCAL EDIT (meta-work experiment): raised from 1800s. The upstream 30-min
+# budget assumed the DIRECT Anthropic API; routing the CUA's 200-turn session
+# through Bedrock is slower per turn (~45 min observed for ~95 turns), so the
+# stage was being cut off mid-run and scored ux=0.0. 7200s (2h) comfortably
+# covers a full 200-turn Bedrock-paced session with headroom.
+timeout_sec = 7200.0
 weight = 0.5
 required = true
 
 [verifiers.cua]
-model = "anthropic/claude-opus-4-7"
+# LOCAL EDIT (meta-work experiment): route the CUA's Claude through Bedrock
+# instead of the direct Anthropic API, so it auths with AWS_BEARER_TOKEN_BEDROCK
+# (we have no raw ANTHROPIC_API_KEY). Same underlying model (Opus 4.7), just the
+# Bedrock route — behaviorally equivalent. Upstream default was already this id.
+model = "bedrock/us.anthropic.claude-opus-4-7"
 start_url = "http://127.0.0.1:8000/"
 rubric_path = "tests/rubric.json"
 instruction_path = "tests/cua_instruction.md"
@@ -206,16 +215,26 @@ timeout_sec = 14400.0
 [environment]
 build_timeout_sec = 1200.0
 cpus = 4
-memory_mb = 16384
+# LOCAL EDIT (meta-work experiment): raised from 16384. The CUA ux stage's
+# Computer1 process accumulates one full base64 screenshot per turn in its
+# in-memory message history (the image-trim only shrinks the SENT request, not
+# the retained list — see harbor anthropic provider), reaching ~16.7GB by
+# ~turn 60-100 and hitting the 16GiB cgroup cap -> OOM-killed mid-stage (kernel
+# "Killed", no traceback; verified via dmesg oom-kill on this container's memcg).
+# 40GB gives headroom for a full 200-turn CUA run; host has 61GB.
+memory_mb = 40960
 storage_mb = 20480
 gpus = 0
 allow_internet = true
 
 [verifiers.env]
-# Anthropic API credentials for the cua stage's Computer1 + LLM-judge.
-# REQUIRED: the cua stage is no longer optional (`required = true` above),
-# so this key must be present at trial time. The previous "fall back to
-# correctness-only when absent" behaviour was a silent collapse of the
-# min(correctness, ux) aggregator; the strict-rubric runs need the ux
-# signal to be load-bearing.
-ANTHROPIC_API_KEY = "${ANTHROPIC_API_KEY}"
+# LOCAL EDIT (meta-work experiment): the cua stage's Computer1 + LLM-judge now
+# run the Claude model via the BEDROCK route (model = "bedrock/..." above), which
+# auths with the Bedrock API key, not a raw Anthropic key. The harness resolves
+# every var declared here against the host env BEFORE any model call
+# (cua_verifier.py -> resolve_env_vars), and throws if one is missing — so we
+# must declare ONLY vars that actually exist on the host. ANTHROPIC_API_KEY does
+# NOT exist here (no raw Anthropic key); declaring it crashed the ux stage at
+# config-resolution time. Declare the Bedrock vars instead.
+AWS_BEARER_TOKEN_BEDROCK = "${AWS_BEARER_TOKEN_BEDROCK}"
+AWS_REGION = "us-east-2"
